        "summary": "登录",
        "description": "同源校验；每个连接来源 IP 每分钟最多 10 次。Cookie 为 HttpOnly、SameSite=Strict；生产启用 Secure。",
        "responses": {
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Principal"
                }
              }
            }
          },
          "400": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
