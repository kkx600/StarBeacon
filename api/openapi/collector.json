    "/api/local/v1/replay/tasks": {
      "post": {
        "summary": "执行采集器本地重放",
        "description": "本地管理员认证；不要求主平台连接可用。package 模式提供旁路 alert 规则文本，registered 模式读取运维登记的规则快照。结果留在本地，不进入平台任务回执队列。",
        "x-required-role": "admin",
        "responses": {
          "202": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
