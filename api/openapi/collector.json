  "openapi": "3.1.0",
  "info": {
    "title": "星烽 StarBeacon 采集器 API",
    "version": "0.1.0",
    "description": "仅描述仓库当前实现的 HTTP 接口。开发端通过 Vite 同源代理访问，生产使用 HTTPS 同源入口。64 位标识和字节计数以字符串传输；接口请求不接受自报租户。"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "SessionCookie": []
    }
  ],
