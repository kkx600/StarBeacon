            "description": "具体原因见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "具体原因见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "具体原因见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sample_id": {
                    "type": "string"
                  },
                  "rule_mode": {
                    "enum": [
                      "package",
                      "registered"
                    ]
                  },
                  "rules": {
                    "type": "string",
                    "maxLength": 921600
                  }
                },
                "required": [
                  "sample_id",
                  "rule_mode"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "starbeacon_collector_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "maxLength": 72
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "Principal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "viewer"
            ]
          },
          "csrf_token": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "tenant_id",
          "username",
          "role",
          "csrf_token"
        ],
        "additionalProperties": false
      },
      "OK": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "HostHealth": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "cpu_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "memory_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "disk_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "rx_bytes": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "tx_bytes": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "wal_pending": {
            "type": "integer",
            "minimum": 0
          },
          "wal_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capture_status": {
            "type": "string",
            "enum": [
              "eve_reader_only"
            ]
          },
          "task_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "command_signer_sha256": {
            "type": "string"
          },
          "registered_rules_available": {
            "type": "boolean",
            "description": "探针是否登记规则快照路径；不代表已加载到实时引擎"
          }
        },
        "required": [
          "version",
          "hostname",
          "observed_at",
          "cpu_percent",
          "memory_percent",
          "disk_percent",
          "rx_bytes",
          "tx_bytes",
          "wal_pending",
          "wal_bytes",
          "errors",
          "capture_status"
        ],
        "additionalProperties": false
      },
      "NetworkInterface": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "index": {
            "type": "integer"
          },
          "mac": {
            "type": "string",
            "description": "宿主机提供的 MAC，可能为空。"
          },
          "mtu": {
            "type": "integer"
          },
          "up": {
            "type": "boolean"
          },
          "loopback": {
            "type": "boolean"
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "index",
          "mac",
          "mtu",
          "up",
          "loopback",
          "addresses"
        ],
        "additionalProperties": false
      },
      "CaptureConfig": {
        "type": "object",
        "properties": {
          "interfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "not_applied"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "interfaces",
          "status"
        ],
        "additionalProperties": false
      },
      "ReplaySample": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "size": {
            "type": "integer",
            "minimum": 24,
            "maximum": 104857600
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "format": {
            "enum": [
              "pcap",
              "pcapng"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "size",
          "sha256",
          "format",
          "created_at",
          "expires_at"
        ],
        "additionalProperties": false
      },
      "TaskReceipt": {
        "type": "object",
        "properties": {
          "command_id": {
            "type": "string"
          },
          "command_sha256": {
            "type": "string"
          },
          "state": {
            "enum": [
              "running",
              "succeeded",
              "failed",
              "unknown"
            ]
          },
          "code": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "additionalProperties": true
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "command_id",
          "command_sha256",
          "state",
          "result",
          "started_at"
        ],
        "additionalProperties": false
      },
      "SensorTask": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sensor_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "diagnostics",
              "rules.validate",
              "rules.replay",
              "rules.apply"
            ]
          },
          "state": {
            "enum": [
              "queued",
              "delivered",
              "running",
              "succeeded",
              "failed",
              "unknown",
              "expired",
              "cancelled"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "receipt": {
            "type": "object",
            "additionalProperties": true
          },
          "acknowledged": {
            "type": "boolean"
          },
          "origin": {
            "enum": [
              "local",
              "platform",
              ""
            ]
          }
        },
        "required": [
          "id",
          "sensor_id",
          "kind",
          "state",
          "created_at",
          "expires_at",
          "receipt"
        ],
        "additionalProperties": false
      }
    }
  }
}
