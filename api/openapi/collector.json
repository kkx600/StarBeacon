        }
      }
    },
    "/api/local/v1/auth/logout": {
      "post": {
        "summary": "退出登录",
        "description": "",
        "responses": {
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OK"
                }
              }
            }
          },
          "400": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "description": "取自登录或 auth/me 返回的 csrf_token。",
            "schema": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            }
          }
        ]
      }
    },
    "/api/local/v1/health": {
      "get": {
        "summary": "读取采集器健康",
        "description": "宿主机 CPU、内存、状态目录磁盘和所有接口的累计计数，不等同于镜像捕获吞吐。",
        "responses": {
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HostHealth"
                }
              }
            }
          },
          "400": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
