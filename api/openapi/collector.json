                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-required-role": "admin"
      },
      "put": {
        "summary": "保存采集目标",
        "description": "仅接受已启用的非回环接口。目标与审计原子写入本地状态；不修改系统网卡、不应用到 Suricata。",
        "responses": {
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaptureConfig"
                }
              }
            }
          },
          "400": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-required-role": "admin",
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "description": "取自登录或 auth/me 返回的 csrf_token。",
            "schema": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "interfaces": {
                    "type": "array",
                    "maxItems": 16,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "interfaces"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "starbeacon_collector_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "maxLength": 72
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "Principal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "viewer"
            ]
          },
          "csrf_token": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "tenant_id",
          "username",
          "role",
          "csrf_token"
        ],
        "additionalProperties": false
      },
      "OK": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "HostHealth": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "cpu_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "memory_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "disk_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "rx_bytes": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "tx_bytes": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "wal_pending": {
            "type": "integer",
            "minimum": 0
          },
          "wal_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capture_status": {
            "type": "string",
            "enum": [
              "eve_reader_only"
            ]
          }
        },
        "required": [
          "version",
          "hostname",
          "observed_at",
          "cpu_percent",
          "memory_percent",
          "disk_percent",
          "rx_bytes",
          "tx_bytes",
          "wal_pending",
          "wal_bytes",
          "errors",
          "capture_status"
        ],
        "additionalProperties": false
      },
      "NetworkInterface": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "index": {
            "type": "integer"
          },
          "mac": {
            "type": "string",
            "description": "宿主机提供的 MAC，可能为空。"
          },
          "mtu": {
            "type": "integer"
          },
          "up": {
            "type": "boolean"
          },
          "loopback": {
            "type": "boolean"
          },
          "addresses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "index",
          "mac",
          "mtu",
          "up",
          "loopback",
          "addresses"
        ],
        "additionalProperties": false
      },
      "CaptureConfig": {
        "type": "object",
        "properties": {
          "interfaces": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "not_applied"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "interfaces",
          "status"
        ],
        "additionalProperties": false
      }
    }
  }
}
