  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "starbeacon_session"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "additionalProperties": false
      },
      "Login": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64
          },
          "password": {
            "type": "string",
            "maxLength": 72
          }
        },
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false
      },
      "Principal": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "viewer"
            ]
          },
          "csrf_token": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "tenant_id",
          "username",
          "role",
          "csrf_token"
        ],
        "additionalProperties": false
      },
      "OK": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      },
      "HostHealth": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "hostname": {
            "type": "string"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "cpu_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "memory_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "disk_percent": {
            "type": [
              "number",
              "null"
            ]
          },
          "rx_bytes": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "tx_bytes": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "wal_pending": {
            "type": "integer",
            "minimum": 0
          },
          "wal_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capture_status": {
            "type": "string",
            "enum": [
              "eve_reader_only"
            ]
          }
        },
        "required": [
          "version",
          "hostname",
          "observed_at",
          "cpu_percent",
          "memory_percent",
          "disk_percent",
          "rx_bytes",
          "tx_bytes",
          "wal_pending",
          "wal_bytes",
          "errors",
          "capture_status"
        ],
        "additionalProperties": false
      },
      "Sensor": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "registration_id": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_seen": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "health": {
            "type": "object",
            "description": "未收到心跳时为 {}；收到心跳后字段见 HostHealth。",
            "additionalProperties": true
          },
          "status": {
            "type": "string",
            "enum": [
              "online",
              "offline",
              "disabled"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "registration_id",
          "active",
          "created_at",
          "last_seen",
          "health",
          "status"
        ],
        "additionalProperties": false
      },
      "Alert": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "tenant_id": {
            "type": "string"
          },
          "sensor_id": {
            "type": "string"
          },
          "sensor_registration_id": {
            "type": "string"
          },
          "source_generation_id": {
            "type": "string"
          },
          "source_offset": {
            "type": "string"
          },
          "sequence": {
            "type": "string"
          },
          "raw_sha256": {
            "type": "string"
          },
          "@timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "event": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "dataset": {
                "type": "string"
              },
              "original": {
                "type": "string",
                "description": "原始 EVE JSON。非管理员返回空字符串。"
              }
