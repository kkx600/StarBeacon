                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "description": "取自登录或 auth/me 返回的 csrf_token。",
            "schema": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/health": {
      "get": {
        "summary": "读取平台依赖健康",
        "description": "",
        "responses": {
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "services": {
                      "type": "object",
                      "properties": {
                        "postgresql": {
                          "type": "string",
                          "enum": [
                            "ready",
                            "unavailable"
                          ]
                        },
                        "redis": {
                          "type": "string",
                          "enum": [
                            "ready",
                            "unavailable"
                          ]
                        },
                        "elasticsearch": {
                          "type": "string",
                          "enum": [
                            "ready",
                            "unavailable"
                          ]
                        }
                      },
                      "required": [
                        "postgresql",
                        "redis",
                        "elasticsearch"
                      ],
                      "additionalProperties": false
                    },
                    "observed_at": {
                      "type": "string",
                      "format": "date-time"
                    }
                  },
                  "required": [
                    "services",
                    "observed_at"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "x-required-role": "admin"
      }
    },
    "/api/v1/audits/operations": {
      "get": {
        "summary": "读取操作日志",
        "description": "当前租户最近 200 条，倒序；不代表实现完整审计筛选和生命周期作业。",
        "responses": {
          "200": {
            "description": "请求成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OperationAudit"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "请求无效、权限不足或依赖不可用，具体含义见 code/message。",
            "content": {
