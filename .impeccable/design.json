  "components": [
    {
      "name": "主要动作按钮",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "主题文件显式配置主要动作背景、悬停与按下颜色；禁用与其余派生态由固定组件主题提供。",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">查询</button>",
      "css": ".ds-btn-primary{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;height:34px;padding:5px 15px;font-size:14px;font-weight:400;line-height:22px;background:var(--primary, #096bff);color:#fff;border:1px solid transparent;border-radius:6px;box-shadow:0 2px 0 var(--primary, #096bff);transition:all .2s cubic-bezier(.645,.045,.355,1);cursor:pointer}.ds-btn-primary:not(:disabled):hover{background:var(--primary-hover, #075de3);cursor:pointer}.ds-btn-primary:not(:disabled):active{background:var(--primary-active, #074ab8)}.ds-btn-primary:focus-visible{outline:2px solid var(--primary, #096bff);outline-offset:3px;}.ds-btn-primary:disabled{cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition-duration:.01ms;animation-duration:.01ms;animation-iteration-count:1}}"
    },
    {
      "name": "记录链接",
      "kind": "button",
      "refersTo": "record-link",
      "description": "点击记录名称进入当前对象详情；轻量文字入口不依赖按钮容器。",
      "html": "<button class=\"ds-record-link\" type=\"button\">HTTP 可疑管理路径访问</button>",
      "css": ".ds-record-link{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;border:0;background:transparent;color:var(--link, #0759d5);font-weight:500;font-size:13px;padding:0;text-align:left;text-underline-offset:3px;cursor:pointer}.ds-record-link:hover{text-decoration:underline}.ds-record-link:focus-visible{outline:2px solid var(--primary, #096bff);outline-offset:3px;}.ds-record-link:disabled{cursor:not-allowed}"
    },
    {
      "name": "检索示例按钮",
      "kind": "button",
      "refersTo": "query-example",
      "description": "检索编辑器的辅助表达式入口；悬停边框与文字采用主色。",
      "html": "<button class=\"ds-query-example\" type=\"button\">源 IP</button>",
      "css": ".ds-query-example{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;border:1px solid var(--line, #e8e8e8);border-radius:4px;background:#fff;color:var(--muted, #526581);padding:4px 8px;font-size:11px;cursor:pointer}.ds-query-example:hover{border-color:var(--primary, #096bff);color:var(--primary, #096bff)}.ds-query-example:focus-visible{outline:2px solid var(--primary, #096bff);outline-offset:3px;}.ds-query-example:disabled{cursor:not-allowed}"
    },
    {
      "name": "检索表达式输入框",
      "kind": "input",
      "refersTo": "query-editor",
      "description": "现行检索编辑框的可读行号、占位提示、主色光标与原生文本选择配色；其余 Ant 派生态继续继承固定组件主题。",
      "html": "<div class=\"ds-query-editor\"><span class=\"ds-query-number\" aria-hidden=\"true\">1</span><textarea class=\"ds-query-field\" rows=\"2\" aria-label=\"检索表达式\" placeholder=\"输入检索表达式\">src_ip == 198.51.100.24</textarea></div>",
      "css": ".ds-query-editor{display:flex;background:var(--table-header, #fafafa);border:1px solid #d9e2ef;border-radius:5px;overflow:hidden}.ds-query-number{padding:11px 10px;color:var(--muted, #526581);background:var(--status-surface, #f3f3f3);font-family:monospace;font-size:12px}.ds-query-field{flex:1;min-width:0;border:0;background:transparent;border-radius:0;box-shadow:none;resize:none;font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;line-height:1.9;padding:9px 12px;font-size:13px;color:var(--text, #22334d);caret-color:var(--primary, #096bff);scrollbar-color:var(--muted, #526581) var(--workspace, #f7f7f7)}.ds-query-field:not(:disabled)::placeholder{color:var(--text-placeholder, #596b84);opacity:1}.ds-query-field:hover{cursor:text}.ds-query-field:focus-visible{box-shadow:none}.ds-query-field::selection{background:var(--selection-surface, #e9e9e9);color:var(--selection-text, #074ab8)}"
    },
    {
      "name": "已访问工作区标签",
      "kind": "nav",
      "refersTo": "workspace-tab",
      "description": "返回最近访问的工作区；与内容区的功能页签分别表达导航层级，标签带保留内部横向滚动。",
      "html": "<nav class=\"ds-workspace-tabs\" aria-label=\"已访问工作区\"><button class=\"ds-workspace-tab\" type=\"button\">态势总览</button><button class=\"ds-workspace-tab ds-workspace-tab-active\" type=\"button\" aria-current=\"page\"><span class=\"ds-tab-dot\" aria-hidden=\"true\"></span>告警管理</button><button class=\"ds-workspace-tab\" type=\"button\">高级检索</button></nav>",
      "css": ".ds-workspace-tabs{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;height:44px;background:#fff;border-bottom:1px solid var(--line, #e8e8e8);display:flex;align-items:flex-end;padding:0 16px;gap:4px;overflow-x:auto;white-space:nowrap}.ds-workspace-tab{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;height:36px;background:transparent;border:0;border-radius:5px 5px 0 0;padding:0 15px;color:var(--muted, #526581);display:flex;align-items:center;gap:7px;font-size:13px;cursor:pointer}.ds-workspace-tab:hover{background:var(--table-header, #fafafa)}.ds-workspace-tab:focus-visible{outline:2px solid var(--primary, #096bff);outline-offset:3px;}.ds-workspace-tab-active{background:var(--tab-selected, #f3f3f3);color:var(--link, #0759d5);box-shadow:inset 0 -2px 0 var(--primary, #096bff)}.ds-tab-dot{height:5px;width:5px;background:var(--primary, #096bff);border-radius:50%}"
    },
    {
      "name": "业务状态标签",
      "kind": "chip",
      "refersTo": "status-tag",
      "description": "文字与圆点共同表达当前对象状态；标签不暗示可点击或已执行。",
      "html": "<div class=\"ds-status-examples\"><span class=\"ds-status-tag ds-status-warning\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span>待研判</span><span class=\"ds-status-tag ds-status-info\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span>研判中</span><span class=\"ds-status-tag\"><span class=\"ds-status-dot\" aria-hidden=\"true\"></span>已关联事件</span></div>",
      "css": ".ds-status-examples{display:flex;gap:8px;flex-wrap:wrap}.ds-status-tag{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;display:inline-flex;align-items:center;gap:5px;padding:3px 7px;border-radius:4px;white-space:nowrap;background:var(--status-surface, #f3f3f3);color:var(--status-text, #526581);font-size:11px;line-height:1.5}.ds-status-dot{display:inline-block;flex-shrink:0;width:6px;height:6px;border-radius:50%;background:#8491a3}.ds-status-warning{background:var(--warning-surface, #fff7e9);color:var(--warning, #a65a00)}.ds-status-warning .ds-status-dot{background:var(--warning-dot, #cd7100)}.ds-status-info{background:var(--info-surface, #f4f4f4);color:var(--info-text, #095ace)}.ds-status-info .ds-status-dot{background:var(--primary, #096bff)}.ds-status-success{background:var(--success-surface, #eff8f2);color:var(--success, #087a43)}.ds-status-success .ds-status-dot{background:var(--success-dot, #079454)}.ds-status-danger{background:var(--danger-surface, #fff0ef);color:var(--danger, #cc2640)}.ds-status-danger .ds-status-dot{background:var(--danger-dot, #e83855)}"
    },
    {
      "name": "内容面板",
      "kind": "card",
      "refersTo": "panel",
      "description": "平面白色容器，以细边框组织内容；标题和底部说明采用共享空间变量，窄屏横向内边距为12px。",
      "html": "<section class=\"ds-panel\"><header class=\"ds-panel-heading\"><h2 class=\"ds-panel-title\">告警记录</h2><span class=\"ds-panel-meta\">10 条记录</span></header><small class=\"ds-panel-footnote\">合成示例仅用于界面评审。</small></section>",
      "css": ".ds-panel{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;background:#fff;border:1px solid var(--line, #e8e8e8);border-radius:8px;min-width:0;color:var(--text, #22334d)}.ds-panel-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:var(--section-gap, 12px) var(--panel-inset, 16px) var(--related-gap, 8px)}.ds-panel-title{margin:0;font-size:15px;font-weight:600;line-height:1.5}.ds-panel-meta{font-size:11px;color:var(--muted, #526581)}.ds-panel-footnote{display:block;font-size:11px;color:var(--muted, #526581);margin:0 var(--panel-inset, 16px) var(--section-gap, 12px)}@media(max-width:899px){.ds-panel{--panel-inset:12px}}"
    },
    {
      "name": "证据范围摘要",
      "kind": "custom",
      "refersTo": "evidence-strip",
      "description": "详情顶部以12px内边距和区块间隔说明当前记录的观测范围与证据边界；列间10px、标签距离7px保留局部规则。",
      "html": "<div class=\"ds-evidence-strip\"><div><span class=\"ds-evidence-label\">租户范围</span><b class=\"ds-evidence-value\">总部安全中心</b></div><div><span class=\"ds-evidence-label\">捕获范围</span><b class=\"ds-evidence-value\">旁路镜像</b></div><div><span class=\"ds-evidence-label\">会话完整性</span><b class=\"ds-evidence-value\">证据不完整</b></div><div><span class=\"ds-evidence-label\">攻击结果</span><b class=\"ds-evidence-value\">无法判定</b></div></div>",
      "css": ".ds-evidence-strip{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;border:1px solid var(--line, #e8e8e8);border-radius:6px;padding:var(--section-gap, 12px);margin-bottom:var(--section-gap, 12px);color:var(--text, #22334d)}.ds-evidence-label{display:block;font-size:11px;color:var(--muted, #526581);margin-bottom:7px}.ds-evidence-value{font-size:12px;font-weight:500}@media(max-width:899px){.ds-evidence-strip{grid-template-columns:1fr 1fr}}@media(max-width:550px){.ds-evidence-strip{grid-template-columns:1fr}}"
    },
    {
      "name": "原始字节选择",
      "kind": "custom",
      "refersTo": "packet-byte-selected",
      "description": "HEX 字节使用等宽字体与明确选中态，白色文字置于主色背景；片段不表示解密或真实取证已经完成。",
      "html": "<div class=\"ds-hex-bytes\" aria-label=\"合成示例字节\"><button class=\"ds-hex-byte\" type=\"button\" aria-label=\"偏移 0，字节 47\">47</button><button class=\"ds-hex-byte ds-hex-byte-selected\" type=\"button\" aria-label=\"偏移 1，字节 45，当前选中\" aria-pressed=\"true\">45</button><button class=\"ds-hex-byte\" type=\"button\" aria-label=\"偏移 2，字节 54\">54</button><button class=\"ds-hex-byte\" type=\"button\" aria-label=\"偏移 3，字节 20\">20</button></div>",
      "css": ".ds-hex-bytes{font-family:ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;white-space:nowrap;display:flex;gap:2px}.ds-hex-byte{color:#34435a;border:0;background:transparent;padding:1px 1px;font-family:inherit;font-size:10px;border-radius:2px;cursor:pointer}.ds-hex-byte:hover,.ds-hex-byte-selected{background:var(--primary, #096bff);color:#fff}.ds-hex-byte:focus-visible{outline:2px solid var(--primary, #096bff);outline-offset:3px;}"
    },
    {
      "name": "业务指标条",
      "kind": "custom",
      "refersTo": "metric",
      "description": "白色指标栏上下间距12px、横向内边距16px，数值与说明相隔4px；窄屏指标块内边距12px，状态含义由文字、数值与说明表达。",
      "html": "<div class=\"ds-metric-bar\"><div class=\"ds-metric-item\"><span class=\"ds-metric-label\">安全事件</span><strong class=\"ds-metric-value\">9</strong><small class=\"ds-metric-note\">合成示例</small></div><div class=\"ds-metric-item ds-metric-danger\"><span class=\"ds-metric-label\">高危与严重告警</span><strong class=\"ds-metric-value\">12</strong><small class=\"ds-metric-note\">合成告警示例</small></div><div class=\"ds-metric-item ds-metric-warning\"><span class=\"ds-metric-label\">探针需要关注</span><strong class=\"ds-metric-value\">2</strong><small class=\"ds-metric-note\">连接、资源与采集质量</small></div></div>",
      "css": ".ds-metric-bar{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",\"PingFang SC\",\"Microsoft YaHei\",sans-serif;display:flex;background:var(--surface, #ffffff);border:1px solid var(--line, #e8e8e8);border-radius:8px;margin-bottom:var(--section-gap, 12px);padding:var(--section-gap, 12px) 0;min-width:0}.ds-metric-item{flex:1;min-width:0;padding:0 var(--panel-inset, 16px);border-right:1px solid var(--line, #e8e8e8);display:flex;flex-direction:column;gap:var(--label-gap, 4px)}.ds-metric-item:last-child{border-right:0}.ds-metric-label{font-size:12px;color:var(--muted, #526581)}.ds-metric-value{font-size:25px;font-weight:650;line-height:1.25;font-variant-numeric:tabular-nums;color:var(--link, #0759d5);white-space:nowrap}.ds-metric-note{font-size:11px;color:var(--muted, #526581)}.ds-metric-danger .ds-metric-label,.ds-metric-danger .ds-metric-value,.ds-metric-danger .ds-metric-note{color:var(--danger, #cc2640)}.ds-metric-warning .ds-metric-label,.ds-metric-warning .ds-metric-value,.ds-metric-warning .ds-metric-note{color:var(--warning, #a65a00)}.ds-metric-success .ds-metric-label,.ds-metric-success .ds-metric-value,.ds-metric-success .ds-metric-note{color:var(--success, #087a43)}@media(min-width:1650px){.ds-metric-bar{padding:var(--section-gap, 12px) 0}.ds-metric-value{font-size:29px}}@media(max-width:1180px){.ds-metric-item{padding:0 var(--panel-inset, 16px)}.ds-metric-value{font-size:23px}}@media(max-width:899px){.ds-metric-bar{flex-wrap:wrap;padding:0;margin-bottom:var(--section-gap, 12px)}.ds-metric-item{flex:1 1 50%;padding:var(--section-gap, 12px);border-bottom:1px solid var(--line, #e8e8e8)}.ds-metric-item:nth-child(even){border-right:0}.ds-metric-item:last-child{border-bottom:0}.ds-metric-value{font-size:23px}}"
    }
  ],
  "narrative": {
    "northStar": "清晰的安全运营工作台",
    "overview": "星烽 StarBeacon 采用用户指定的后台布局，以白色导航、白色指标与内容面板、纯浅灰工作区和明亮蓝色动作形成清晰的安全运营环境。表格、表单、详情与操作弹窗承载主要工作；视觉层级服务于识别对象、核对依据和执行获准动作。\n\n工作区保持足够的信息密度，以文字、对齐、细边框与留白区分内容。记录名称可进入详情，严重级别与执行状态同时提供可读文字和颜色。态势大屏使用独立深灰工作区、高亮蓝青数字和玫红风险值；这套局部配色不改变控制台的浅色基准。\n\n本系统从已交付的 Vue 3、TypeScript 与 Ant Design Vue 原型提取；原型全部使用合成数据，操作仅改变本地内存。设计说明不代表后端、身份、模型、MCP、设备访问、数据清理或性能已经验收。",
    "keyCharacteristics": [
      "白色导航、指标与结构面板，纯浅灰工作区与认证背景；明亮操作蓝与深蓝链接分别表达动作和记录入口。",
      "桌面优先，表格、表单、详情和操作弹窗使用一致的空间与状态语言。",
      "系统中文字体、等宽技术字段和等宽数字分别承担阅读、取证与数值比较。",
      "证据不足、不可观测、运行模式与生命周期各自保持独立含义。"
    ],
    "rules": [
      {
        "name": "文字与颜色",
        "body": "颜色辅助定位状态；严重级别、生命周期、执行结果与证据缺口必须同时有可读文字。未知、不完整与不可观测写出原因，只有满足对应业务状态的记录才呈现成功含义。",
        "section": "colors"
      },
      {
        "name": "语义提示",
        "body": "静态业务边界使用低强调的信息提示；警示色表达当前风险、异常状态或会影响操作的限制，不将所有页面说明标为警示。",
        "section": "colors"
      },
      {
        "name": "色源一致",
        "body": "业务色从主题文件取用；共享样式使用根级 CSS 变量，图表使用同一调色板，挂载到 body 的浮层与静态截图目录保持角色颜色一致。派生色带只用于设计面板，不进入界面色源。",
        "section": "colors"
      },
      {
        "name": "正文与取证",
        "body": "业务文字使用声明的系统字体栈；原始查询、协议字节和技术标识使用等宽字体，连续数值使用等宽数字。",
        "section": "typography"
      },
      {
        "name": "平面工作区",
        "body": "控制台面板依靠底色、细边框与间距区分；投影用于控件反馈与窄屏覆盖导航，不为每个内容面板制造浮起效果。",
        "section": "elevation"
      },
      {
        "name": "业务指标",
        "body": "指标必须对应当前对象与可解释的统计口径。探针指标来自同一筛选数据集与健康阈值；离线、心跳超时和执行角色不显示推定正常的采集指标。当前范围没有捕获遥测时，观测镜像流量显示“—”及原因，不能以零流量代替不可观测。态势总览与态势大屏的探针指标使用探针列表的同一设备快照和健康阈值，按各自网络域或展示范围筛选，加载与失败时不展示指标；其他业务图表仍为合成场景，不表示所有模块已实现联动统计。",
        "section": "components"
      },
      {
        "name": "工作任务连续",
        "body": "同一对象的列表、运行状态、依据与操作在所属工作区和对象详情中衔接；避免为重复数据集或同一任务的下载步骤建立平行入口。",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** 保持导航、指标和面板白色，工作区与认证背景使用纯浅灰，表头、辅助区域与选中项采用纯灰底，沿用用户指定的后台布局。",
      "**Do** 将操作蓝用于主要动作，链接蓝用于记录与导航文字，状态色与浅底配对，并保留文字说明。",
      "**Do** 为每类对象使用对应的生命周期；运行模式、设备接受、配置回读与效果观察分别展示。",
      "**Do** 使来源、时间、租户范围、完整性与证据缺口绑定当前记录；缺少依据时说明尚不可确定的内容。",
      "**Do** 保留有数据、无数据、详情、操作、加载和失败之间的语义差异，并提供业务原因或下一步。",
      "**Do** 在普通输入框与选择框中保持占位提示可读，使用可辨识的正常控件边界，禁用控件保留独立语义。",
      "**Do** 以 0–1 保存置信度，列表、详情与导出使用百分比；表单说明单位。",
      "**Do** 让表格在自己的容器内横向滚动，窄屏表单转单列，并保留可见的操作出口。",
      "**Do** 通过工作区页签与对象详情衔接相关任务，共用探针记录、健康口径与任务身份。",
      "**Do** 只展示适用的业务指标，静态边界说明使用低强调的信息提示，警示提示表达当前风险或限制。",
      "**Do** 将 180 天业务留存、旁路可见性、TLS 密文与合成数据说明作为用户理解当前结果所需的边界信息。"
    ],
    "donts": [
      "**Don't** 用空状态、加载失败或权限不足替代彼此的业务含义。",
      "**Don't** 用其它记录的样本、固定成功回执或推定解密结果填补当前对象的证据缺口。",
      "**Don't** 将影子、审批与自动执行写成生命周期，或将设备接受显示为配置已生效与效果已验证。",
      "**Don't** 将原型评审状态下拉、本地提交、示例回复或合成指标写成生产能力承诺。",
      "**Don't** 把大屏的深色工作区配色扩散到普通表格与表单页面，或为平面面板增加装饰性厚重阴影。",
      "**Don't** 为控制台、认证入口、辅助区域或选中项使用浅蓝背景；蓝色保留在动作、链接、图表、文字和焦点等前景语义。",
      "**Don't** 传承未被现行界面采用的标题前装饰标签样式，或把登录入口的局部展示尺寸扩散为通用页面标题。",
      "**Don't** 把侧车合成色带、未独立采样的组件派生态或局部窄屏检查当作已经确认的全局 token 或完整验收。"
    ]
  }
}
