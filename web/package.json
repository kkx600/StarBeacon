{
  "name": "starbeacon-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './platform' --filter './collector' run build",
    "test": "node --test scripts/*.test.mjs && vitest run",
    "test:coverage": "node --test scripts/*.test.mjs && vitest run --coverage",
    "typecheck": "pnpm -r --filter './platform' --filter './collector' run typecheck && vue-tsc --noEmit -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@codemirror/view": "6.43.13",
    "@starbeacon/shared": "workspace:*",
    "@types/node": "24.19.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/test-utils": "2.5.1",
    "ant-design-vue": "catalog:",
    "echarts": "6.1.0",
    "jsdom": "30.1.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "5.0.3",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:"
  },
  "license": "Apache-2.0"
}
